# Copy to .env and fill in. NEVER commit .env.
# ArmorIQ (required for the real allow/hold/block pipeline)
ARMORIQ_API_KEY=ak_test_paste_your_key_here
ARMORIQ_ENV=production
ARMORIQ_AGENT_NAME=kavalan-guardian
ARMORIQ_MCP_PAYMENTS=kavalan-payments
ARMORIQ_MCP_PHARMACY=kavalan-pharmacy

# End-user identity the agent acts for (policy is applied per user email)
KAVALAN_USER_EMAIL=amma@example.com

# LLM for the agent loop (TEXT mode first; scaffold uses keyword plans until wired)
LLM_API_KEY=
LLM_MODEL=gpt-4

# Voice stubs (ElevenLabs; not implemented in scaffold)
ELEVENLABS_API_KEY=

# Approval service (family member opens this on their phone)
APPROVAL_BASE_URL=http://127.0.0.1:8000
APPROVAL_PORT=8000

# Sandbox storage (fake ledger, no real money/bank data)
KAVALAN_DB=data/kavalan.db
KAVALAN_APPROVAL_DB=data/approval.db
KAVALAN_DECISION_LOG=logs/decisions.jsonl
